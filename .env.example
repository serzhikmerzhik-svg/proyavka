# Скопируйте в .env (рядом с этим файлом) и заполните. Без ключей всё работает на эвристике.

# Порт API в dev (Vite проксирует /api сюда)
API_PORT=8787
# Порт в продакшене (обычно задаёт хостинг)
PORT=8787

# Языковая модель для /api/analyze: anthropic | openai | none.
# Если не задано — берётся провайдер, чей ключ указан ниже; нет ключей — эвристика.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# по умолчанию claude-opus-5-5; усилие low хватает для разбора по схеме
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
# по умолчанию gpt-4.1-mini
OPENAI_MODEL=
# таймаут одного запроса к модели, мс
LLM_TIMEOUT_MS=60000

# Озвучка: openai | yandex | none. Пусто — OpenAI, если задан OPENAI_API_KEY (yandex пока не подключён)
TTS_PROVIDER=
# по умолчанию gpt-4o-mini-tts; если модель игнорирует стиль, зафиксируйте снимок, например gpt-4o-mini-tts-2025-12-15
TTS_MODEL=
# голос; пусто — подбирается под атмосферу дня
OPENAI_TTS_VOICE=

# ИИ-оживление кадра через видео-API — ОПЦИЯ вне §9, по умолчанию выключена.
# Включается только явно: VIDEO_PROVIDER=kling + ключи Kling (Access Key / Secret Key).
VIDEO_PROVIDER=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# по умолчанию kling-v2-6, режим std (pro дороже)
KLING_MODEL=
KLING_MODE=std
